# Local Development Environment Configuration (Floci Emulator)
# Copy this file to .env: cp .env.example .env
# Then load it into your shell: source .env

export AWS_ACCESS_KEY_ID="mock-access-key"
export AWS_SECRET_ACCESS_KEY="mock-secret-key"
export AWS_DEFAULT_REGION="us-east-1"
export AWS_ENDPOINT_URL="http://localhost:4566"
