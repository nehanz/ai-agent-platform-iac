# Local .terraform directories
**/.terraform/
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore plan files (may contain sensitive data)
*.tfplan*

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Floci emulator local storage
.floci-data/

# Environment files
.env
.env.*
!.env.example

# Provider lock files
.terraform.lock.hcl
**/.terraform.lock.hcl

# Lambda package archives and build directories
dist/
**/dist/
*.zip
modules/**/src/

